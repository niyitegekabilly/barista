<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to sensitive directories
    RewriteRule ^(config|database|storage|app|resources|\.env|\.git)/ - [F]

    # Rewrite asset and upload requests to public folder
    RewriteRule ^assets/(.*)$ public/assets/$1 [L,NC]
    RewriteRule ^uploads/(.*)$ public/uploads/$1 [L,NC]

    # Don't rewrite if it's a real file or directory
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all other requests to public/index.php
    RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>

# Proper MIME types for assets
<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js
    AddType application/json .json
    AddEncoding gzip .gz
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Disable directory indexing
Options -Indexes
