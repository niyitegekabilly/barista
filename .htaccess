<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /bbacademy/

    # Rewrite asset requests to point to public folder
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]
    RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

    # Block access to sensitive directories
    RewriteRule ^(config|database|storage|app|resources|\.env|\.git)/ - [F]

    # Don't rewrite if it's a real file
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Route all other requests to public/index.php
    RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>

# Proper MIME types for assets
<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js
    AddType application/json .json
    AddEncoding gzip .gz
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Disable directory indexing
Options -Indexes
